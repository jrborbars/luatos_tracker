# FUFU Air780EG tracker - configuration
# Copy this file to .env (git-ignored) and adjust the values.
# LuaTools flashes it into /luadb/.env; loadenv.lua looks there first.
# Simple KEY=VALUE lines, no spaces around "=", no inline comments.

# --- MQTT ---------------------------------------------------------------
MQTT_BROKER=mqtt.openluat.com
MQTT_PORT=1883
# 1 = TLS. Defaults to 1 when the port is 8883 or 8884 (EMQX Cloud, most
# managed brokers). TLS uses no certificate verification (mqtt.create ssl=true).
MQTT_SSL=0
# Client id must be unique per device, or the broker keeps kicking the others.
# Leave empty to use the IMEI, or use a prefix with $imei, e.g. tracker_$imei
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=tracker/position
# Seconds, libemqtt clamps to 15..600
MQTT_KEEPALIVE=240
# Reconnect delay in ms (autoreconn)
MQTT_RECONNECT_MS=5000
# 0 = at most once, 1 = at least once (recommended for trackers)
MQTT_QOS=1

# --- GNSS ---------------------------------------------------------------
# Internal GPS+Beidou receiver of the Air780E family is wired to uart2
GNSS_UART=2
GNSS_BAUD=115200
# 1 dumps every NMEA sentence to the log, use only while debugging
GNSS_DEBUG=0

# --- Reporting ----------------------------------------------------------
# Position sampling period, ms
POSITION_INTERVAL=10000
# Repeat interval while the device is not moving, ms
HEARTBEAT_INTERVAL=60000
# How long to wait for a cellular IP before rebooting, ms
NET_TIMEOUT=60000

# --- FOTA (iot.openluat.com) -------------------------------------------
# Register the project at iot.openluat.com and paste the 64 character key
PRODUCT_KEY=YOUR_64_CHARACTER_PRODUCT_KEY_HERE
# VERSION is defined in main.lua and must stay XXX.YYY.ZZZ for the iot platform

# --- Logging ------------------------------------------------------------
# SILENT / DEBUG / INFO / WARN / ERROR / FATAL
LOG_LEVEL=INFO
